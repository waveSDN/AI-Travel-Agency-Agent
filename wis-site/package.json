{
  "name": "wis-site",
  "version": "0.1.0",
  "private": true,
  "description": "Wave Intelligence Solutions (WIS) — Arabic RTL website with the WIS assistant (Gemini API, server-side only)",
  "main": "server/index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --runInBand",
    "test:e2e": "npm run build && node tests/e2e/run.js",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "express": "4.22.3",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "jest": "29.7.0",
    "playwright": "1.56.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "testTimeout": 15000
  }
}
