# Copy to .env (never commit it) or set these in the host's secret settings.

# --- Server
PORT=3100
HOST=127.0.0.1
NODE_ENV=development
# Comma-separated extra origins allowed to call the API (same origin is always allowed)
ALLOWED_ORIGINS=
# Behind a reverse proxy: number of trusted hops (e.g. 1), so per-IP limits see the visitor address
TRUST_PROXY=

# --- Gemini (server only; never prefix with NEXT_PUBLIC_ or ship to the browser)
# Leave empty to run with approved answers only.
GEMINI_API_KEY=
# Kill switch: false turns live answers off immediately
GEMINI_ENABLED=true
# A stable model your key can use on the free tier; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
# Extra attempts for 5xx/network errors only (never for 429)
GEMINI_MAX_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TEMPERATURE=0.3
# minimal | low | none (none = do not send a thinking setting)
GEMINI_THINKING=minimal
# Instant off switch without a restart: while this file exists, live answers are disabled
GEMINI_KILL_SWITCH_FILE=

# --- Trial limits (per process, in memory; not Google quotas)
ASSISTANT_MAX_MESSAGE_CHARS=1500
ASSISTANT_MAX_TURNS=10
ASSISTANT_MAX_CONTEXT_CHARS=8000
ASSISTANT_SESSION_RPM=5
ASSISTANT_IP_RPM=20
ASSISTANT_DAILY_LIMIT=100
ASSISTANT_SESSION_TTL_MIN=30
ASSISTANT_MAX_SESSIONS=2000
